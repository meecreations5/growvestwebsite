# ==========================================================
# GrowVest public website
# Never commit real server-side credentials.
# ==========================================================

# Canonical public website URL (not the Investor Portal URL)
NEXT_PUBLIC_SITE_URL=https://growvest.info
NEXT_PUBLIC_INVESTOR_PORTAL_URL=https://insights.growvest.info/investor-login

# Search indexing
# Keep false for local, preview and staging deployments.
# Set true only in the approved production deployment.
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Firebase browser configuration for the GrowVest public website app.
# These NEXT_PUBLIC values identify the web app and are safe for browser use.
# Analytics initializes only after the visitor accepts analytics consent.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDWXqIeasc3hpqep50tpRFlXxc5kh8uzc4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=growvest-reporttool.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=growvest-reporttool
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=growvest-reporttool.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=712836553685
NEXT_PUBLIC_FIREBASE_APP_ID=1:712836553685:web:eea8940bdc609156d1bb5c
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-EB8M6Z12Q5

# Microsoft provider used by GrowVest Website Admin login.
NEXT_PUBLIC_MICROSOFT_TENANT_ID=7806e5f3-2e1e-490e-851b-10e85deb1990

# ==========================================================
# Firebase Admin SDK - server only
# Add these only in .env.local and the Vercel environment.
# ==========================================================
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_ROTATED_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_STORAGE_BUCKET=

# A long, stable, random value used to hash request identifiers.
# Generate a new value; do not reuse an exposed CRON or webhook secret.
FORM_RATE_LIMIT_SALT=

# Allowed extra origins for form POST requests, comma separated.
# Add the exact Vercel preview origin only when preview form testing is required.
ALLOWED_FORM_ORIGINS=

# ==========================================================
# Brevo - server only
# ==========================================================
BREVO_API_KEY=
BREVO_DEFAULT_SENDER_NAME=Your Conscious Wealth Partner
BREVO_DEFAULT_SENDER_EMAIL=cwp@growvest.info
BREVO_REPLY_TO_EMAIL=cwp@growvest.info
GROWVEST_NOTIFICATION_EMAIL=connect@growvest.info

# Required for newsletter subscriptions. Enter the numeric Brevo list ID.
BREVO_NEWSLETTER_LIST_ID=

# Scheduled Insights publishing — server only
CRON_SECRET=
