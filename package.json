{
  "name": "growvest-nextjs-app-router",
  "version": "26.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:env": "node scripts/validate-env.mjs",
    "verify": "npm run lint && npm run build",
    "bootstrap:website-admin": "node scripts/bootstrap-website-admin.mjs",
    "check:routes": "node scripts/check-route-collisions.mjs",
    "cleanup:legacy-routes": "node scripts/cleanup-legacy-public-routes.mjs --apply",
    "prebuild": "npm run check:routes",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:assets": "node scripts/check-public-assets.mjs",
    "check:a11y": "node scripts/check-accessibility-basics.mjs",
    "check:security": "node scripts/check-security-config.mjs",
    "check:source": "npm run check:routes && npm run check:imports && npm run check:syntax && npm run check:secrets && npm run check:assets && npm run check:a11y && npm run check:security && npm run check:seo && npm run check:performance && npm run check:mobile",
    "readiness": "npm run check:env -- --production && npm run check:source && npm run lint && npm run build",
    "smoke": "node scripts/smoke-test.mjs",
    "release:verify": "npm run readiness && npm run smoke",
    "check:imports": "node scripts/check-local-imports.mjs",
    "check:syntax": "node scripts/check-jsx-balance.mjs",
    "check:seo": "node scripts/check-seo-basics.mjs",
    "check:performance": "node scripts/check-performance-basics.mjs",
    "check:mobile": "node scripts/check-mobile-ui-basics.mjs"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "next": "15.5.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "firebase-admin": "^13.5.0",
    "firebase": "11.10.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.5.21",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module"
}
